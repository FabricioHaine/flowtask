# FlowTask — variáveis de ambiente do backend (copie para .env e ajuste).
# NÃO comite valores reais: este arquivo é apenas modelo.

# Banco de dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/flowtask
DB_USER=flowtask
DB_PASSWORD=flowtask

# Porta da API
APP_PORT=8080

# Segredo do JWT: gere com 64 bytes aleatórios em base64
# (Linux/macOS: openssl rand -base64 64 | tr -d '\n')
# NÃO use o valor abaixo em produção.
JWT_SECRET=

# Duração da sessão (8h por default)
JWT_EXPIRACAO_SEGUNDOS=28800

# CORS do frontend
CORS_ORIGINS=http://localhost:4200

# SMTP para envio de convites (false = só dentro do produto)
EMAIL_HABILITADO=false
MAIL_FROM=flowtask@localhost

# Validade dos convites (7 dias por default)
CONVITE_EXPIRACAO_DIAS=7
